+//! Test-only re-exports of crate-private verification steps for a differential oracle.
+use crate::membership_commitment::{MerkleBatchPath, MerkleTreeBatchCommitment, MerkleTreeConcatenationLeaf};
+pub use crate::signature_scheme::{BlsSignature, BlsVerificationKey};
+use crate::{MembershipDigest, MithrilMembershipDigest, PhiFValue, Stake, StmResult, VerificationKeyForConcatenation};
+
+pub type ConcatHash = <MithrilMembershipDigest as MembershipDigest>::ConcatenationHash;
+
+pub fn is_lottery_won(phi_f: PhiFValue, ev: [u8; 64], stake: Stake, total_stake: Stake) -> StmResult<bool> {
+    crate::proof_system::is_lottery_won(phi_f, ev, stake, total_stake)
+}
+
+pub fn evaluate_dense_mapping(sigma: &BlsSignature, msgp: &[u8], index: u64) -> [u8; 64] {
+    sigma.evaluate_dense_mapping(msgp, index)
+}
+
+pub fn verify_batch_path(
+    root: Vec<u8>,
+    nr_leaves: usize,
+    leaves: &[(VerificationKeyForConcatenation, Stake)],
+    path: &MerkleBatchPath<ConcatHash>,
+) -> StmResult<()> {
+    let c = MerkleTreeBatchCommitment::<ConcatHash, MerkleTreeConcatenationLeaf>::new(root, nr_leaves);
+    let l: Vec<_> = leaves.iter().map(|(v, s)| MerkleTreeConcatenationLeaf(*v, *s)).collect();
+    c.verify_leaves_membership_from_batch_path(&l, path)
+}
